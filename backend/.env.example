# ─── SOC Platform — Backend Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# Then load it before starting the backend:
#   set -a && source .env && set +a
# ─────────────────────────────────────────────────────────────────────────────

# ── Required paths ────────────────────────────────────────────────────────────
# Path to Suricata's JSON event log
EVE_JSON_PATH=/var/log/suricata/eve.json

# Path to the MaxMind GeoLite2-City database file (.mmdb)
# Download from https://www.maxmind.com/en/geolite2/signup (free account)
# Place the .mmdb file in backend/ and set this path accordingly
GEOIP_DB_PATH=./GeoLite2-City.mmdb

# SQLite database path (auto-created on first run, no changes needed)
# SQLITE_DB_PATH=./data/soc_alerts.db

# ── Email alerts (optional) ───────────────────────────────────────────────────
# Leave blank to disable email notifications entirely.
# Uses Gmail SMTP with SSL (port 465). Requires an App Password:
#   https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-soc-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
ALERT_RECIPIENT=analyst@example.com

# Severity threshold: alerts with severity <= this value trigger email (1-4)
# 1 = critical only, 2 = high+critical (recommended), 3 = noisy, 4 = very noisy
EMAIL_SEVERITY_THRESHOLD=2

# ── API settings ─────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Monitor tuning ────────────────────────────────────────────────────────────
# How often the log monitor polls eve.json for new lines (seconds)
MONITOR_POLL_INTERVAL=1.0

# Number of alerts to buffer in memory before flushing to SQLite
MONITOR_BATCH_SIZE=50

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
